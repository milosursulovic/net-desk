# Dependencies
node_modules/

# Environment variables (never commit secrets - keep .env.example tracked)
.env
.env.*
!.env.example

# Build output
frontend/dist/
frontend/dist-ssr/
frontend/dev-dist/
*.local

# Uploaded agent release packages
backend/uploads/

# Server-specific auto-deploy script (hardcoded paths/task names, not shared)
deploy/

# .NET (service/)
service/**/bin/
service/**/obj/
service/**/*.user
service/.release-staging/
.vs/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# SSL certificates / keys (local dev HTTPS)
*.pem
*.key
*.crt
*.cer

# OS files
.DS_Store
Thumbs.db

# Editor / IDE
.vscode/*
!.vscode/extensions.json
.idea/

# Tooling
.VSCodeCounter/

# graphify - regenerable knowledge-graph artifacts (large, binary-ish, no
# review value in git history); GRAPH_REPORT.md is the one human-readable
# output worth tracking, kept out of this ignore.
graphify-out/*
!graphify-out/GRAPH_REPORT.md

# Claude Code - settings.json is shared/tracked, settings.local.json is
# per-machine personal overrides (permission tweaks etc.), never shared.
.claude/settings.local.json
