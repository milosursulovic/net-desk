<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!--
      Deliberately the ONLY net target (it doesn't follow the Common/Service dual tier) - since this
      change the Manager is completely standalone, with zero dependencies on
      Netdesk.Agent.Common, so there's no reason to follow the agent's net452/net472
      split either. It stays net452 purely for Win7 support (the same reason as before),
      regardless of which tier the Service/Agent uses on the same machine.
    -->
    <TargetFramework>net452</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>Netdesk.Agent.Manager</AssemblyName>
    <RootNamespace>NetdeskAgent.Manager</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.ServiceProcess" />
    <Reference Include="System.Configuration.Install" />
    <!-- UpdateReportClient.cs (the mailbox path) and ManagerApiClient.cs (the new,
         independent HTTP channel) - all the network calls the Manager ever makes. -->
    <Reference Include="System.Net.Http" />
    <!-- InstallUpdateFromServerAsync (ManagerWorker.cs) - ZipFile.ExtractToDirectory
         for install_update commands from the new channel, the same pair of references as
         Netdesk.Agent.Common.csproj. -->
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <!-- StopWinDivertDriverIfPresent (ManagerWorker.cs) - Win32_SystemDriver
         via WMI, the same technique as the "Prinudno zaustavi WinDivert drajver" (force-stop WinDivert driver)
         PowerShell preset (powershellPresets.js). -->
    <Reference Include="System.Management" />
  </ItemGroup>

  <ItemGroup>
    <!--
      A direct dependency (no longer transitive via Netdesk.Agent.Common) -
      only for ManagerCommand JSON (de)serialization and the UpdateReportClient
      payload. websocket-sharp is NOT here - that was purely transitive
      junk via the old Common reference (the Manager never used the VNC
      bridge), now correctly absent.
    -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

</Project>
