<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!--
      Namerno JEDINI net-target (ne prati Common/Service dual-tier) - Manager
      je od ove izmene potpuno samostalan, nula zavisnosti od
      Netdesk.Agent.Common, pa nema ni razloga da prati agent-ov net452/net472
      split. Ostaje net452 čisto zbog Win7 podrške (isti razlog kao pre),
      nezavisno od toga koji tier Service/Agent koristi na istoj mašini.
    -->
    <TargetFramework>net452</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>Netdesk.Agent.Manager</AssemblyName>
    <RootNamespace>NetdeskAgent.Manager</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.ServiceProcess" />
    <Reference Include="System.Configuration.Install" />
    <!-- UpdateReportClient.cs (mailbox put) i ManagerApiClient.cs (novi,
         nezavisni HTTP kanal) - oba mrežna poziva Manager ikad pravi. -->
    <Reference Include="System.Net.Http" />
    <!-- InstallUpdateFromServerAsync (ManagerWorker.cs) - ZipFile.ExtractToDirectory
         za install_update komande sa novog kanala, isti par referenci kao
         Netdesk.Agent.Common.csproj. -->
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Direktna zavisnost (ne više tranzitivna preko Netdesk.Agent.Common) -
      samo za ManagerCommand JSON (de)serijalizaciju i UpdateReportClient
      payload. websocket-sharp NIJE ovde - to je bilo čisto tranzitivno
      smeće preko stare Common reference (Manager nikad nije koristio VNC
      bridge), sad ispravno odsutno.
    -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

</Project>
