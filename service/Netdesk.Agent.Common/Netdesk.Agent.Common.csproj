<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net452</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>Netdesk.Agent.Common</AssemblyName>
    <RootNamespace>NetdeskAgent.Common</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Pinned to 2.0.77 deliberately - it's the LAST version that still ships
      a net45 lib target (verified live: 3.x+ only ships netstandard2.0/
      net462+, neither of which net452 can consume; net461 is the actual
      floor for netstandard2.0 consumers). Used for DnsLogs.DnsQueryCollector
      (live ETW session on Microsoft-Windows-DNS-Client). Do not bump this
      package without re-checking its lib/ folder for a net4x target first.
    -->
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="2.0.77" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <!--
      System.Net.WebSockets.ClientWebSocket throws PlatformNotSupportedException
      on Windows 7/Server 2008 R2 - it depends on WinHTTP WebSocket APIs only
      present from Windows 8 onward, discovered live on a Windows 7 target
      machine. This project explicitly targets net452 BECAUSE of Windows 7
      support (see csproj/README), so a pure-managed WS client that doesn't
      depend on that OS-level API is required instead. WebSocketSharp-netstandard
      is a maintained fork of websocket-sharp (RFC 6455 implemented in C# over
      raw sockets, no WinHTTP dependency), explicitly supports ".NET 3.5 or later".
    -->
    <PackageReference Include="WebSocketSharp-netstandard" Version="1.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Management" />
    <Reference Include="System.Net.Http" />
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.ServiceProcess" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>

</Project>
