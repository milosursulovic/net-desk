<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Single-file setup (NetdeskAgentSetup.exe) for a fresh install of the agent
    (Service) and the Manager on a managed computer. Deliberately NOT part of
    Netdesk.Agent.sln: it isn't shipped through auto-update and must not change
    how the agent itself is built. Build it via service/Build-Installer.ps1,
    which embeds the payload (Service\, Manager\, configs, root CA) as a resource.

    net452 + no NuGet dependencies, so the output is ONE .exe that runs on
    every machine that can run the agent itself (Windows 7 SP1+ with
    .NET Framework 4.5.2+).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net452</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>NetdeskAgentSetup</AssemblyName>
    <RootNamespace>NetdeskAgent.Installer</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- 64-bit process on 64-bit Windows, so "Program Files", System32 and the
         registry are the real (non-redirected) ones. -->
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.ServiceProcess" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>

  <!-- PayloadZip is passed by Build-Installer.ps1 (-p:PayloadZip=...). Without it
       the exe still builds, but refuses to run (no embedded payload). -->
  <ItemGroup Condition="'$(PayloadZip)' != ''">
    <EmbeddedResource Include="$(PayloadZip)" LogicalName="payload.zip" />
  </ItemGroup>

</Project>
