<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Vidi napomenu u Netdesk.Agent.Common.csproj - isti dual-tier razlog. -->
    <TargetFrameworks>net452;net472</TargetFrameworks>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>Netdesk.Agent.Service</AssemblyName>
    <RootNamespace>NetdeskAgent.Service</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <!--
    Eksplicitan sopstveni simbol umesto oslanjanja na SDK auto-definisane
    per-TFM konstante (nepouzdano proveriti bez prave build mašine - uživo
    testirano u ovoj sesiji preko -getProperty:DefineConstants, koje NIJE
    pokazalo očekivan NET472/NET452 simbol za ove starije monikere na
    lokalnoj SDK verziji). AgentWorker.cs koristi #if NETDESK_WEBRTC_CAPABLE
    da bi stvarni start_webrtc_bridge kod postojao SAMO u net472 build-u -
    isti razlog kao Compile Remove za Webrtc/ folder u Common.csproj.
  -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net472'">
    <DefineConstants>$(DefineConstants);NETDESK_WEBRTC_CAPABLE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.ServiceProcess" />
    <Reference Include="System.Configuration.Install" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Netdesk.Agent.Common\Netdesk.Agent.Common.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="config.example.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!--
      WinDivert 2.2.2, x64 samo (Win7/32-bit namerno nepodržani za ovaj
      feature - vidi DnsLogs/WinDivertInterop.cs). WinDivert traži da ova
      dva fajla sede u "application's home directory" (isti folder kao
      .exe) - <Link> ih zato ravno mapira u output koren, ne u WinDivert\
      podfolder gde fizički žive u repo-u.
    -->
    <None Include="WinDivert\WinDivert.dll">
      <Link>WinDivert.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="WinDivert\WinDivert64.sys">
      <Link>WinDivert64.sys</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="WinDivert\LICENSE-WinDivert.txt">
      <Link>LICENSE-WinDivert.txt</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
