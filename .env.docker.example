# .env za docker-compose.yml (kopiraj u ".env" pored docker-compose.yml,
# NIKAD ne commit-uj popunjenu verziju - isti princip kao backend/.env.example).
# Ovaj fajl čita i sam docker-compose.yml (za ${VAR} supstituciju, npr. PORT)
# i "app" servis preko env_file (isporučuje se kontejneru kao process env,
# 1:1 isti oblik kao backend/.env.example - vidi backend/config/env.js).

# "production" na produkciji (uključuje HSTS i CORS deny-by-default fallback).
NODE_ENV=production
HOST=0.0.0.0
PORT=3000

# DB_HOST se NAMERNO ne koristi odavde - docker-compose.yml ga uvek postavlja
# na "db" (ime servisa, Docker-ova interna DNS rezolucija), bez obzira šta je
# ovde upisano. DB_NAME/DB_USER/DB_PASS ovde MORAJU da se poklapaju sa onim
# što je stvarno u bazi (isti podaci se koriste i za MARIADB_DATABASE/
# MARIADB_USER/MARIADB_PASSWORD kod "db" servisa pri PRVOM podizanju praznog
# db-data volume-a - posle toga MariaDB ove env promenljive ignoriše).
DB_HOST=db
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=
# Samo za "db" servis (MARIADB_ROOT_PASSWORD) - aplikacija ovo nikad ne čita.
DB_ROOT_PASSWORD=
# Opciono - podrazumevano 30 ako se ne postavi (vidi backend/config/env.js).
DB_CONNECTION_LIMIT=

JWT_SECRET=
AGENT_ENROLL_TOKEN=

# Putanje UNUTAR kontejnera (./certs sa host-a je bind-mount-ovan na /certs:ro
# u docker-compose.yml) - imena fajlova moraju da se poklapaju sa onim što je
# stvarno stavljeno u ./certs/ na host-u. AGENT_SIGNING_* ostaju prazni ako se
# release paketi ne potpisuju (opciono, vidi backend/utils/agentSigning.js).
SSL_KEY=/certs/server-key.pem
SSL_CERT=/certs/server.pem
AGENT_SIGNING_CERT_PATH=/certs/agent-signing.pem
AGENT_SIGNING_KEY_PATH=/certs/agent-signing-key.pem

# Origin-i sa kojih browser sme da zove ovaj API. Browser šalje Origin header
# i na same-origin fetch/XHR pozive (naročito POST/PUT/DELETE), a ova provera
# to ne razlikuje od cross-origin - MORA da sadrži i sopstveni origin backend-a
# (npr. https://10.230.62.81:3000), ne sme da ostane prazno u produkciji.
CORS_ALLOWED_ORIGINS=

# Opciono - push notifikacije isključene ako ostanu prazni.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Opciono - deljena UltraVNC lozinka (vidi backend/services/vncSessions.service.js).
VNC_SHARED_PASSWORD=
